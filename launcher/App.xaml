<Application x:Class="DiscodicXP.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Gold" Color="#E0BD7A"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#242326"/>
            <Setter Property="Foreground" Value="#F5F1EA"/>
            <Setter Property="BorderBrush" Value="#555056"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#242326"/>
            <Setter Property="Foreground" Value="#F5F1EA"/>
            <Setter Property="BorderBrush" Value="#555056"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E0BD7A"/>
            <Setter Property="Foreground" Value="#201B16"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
