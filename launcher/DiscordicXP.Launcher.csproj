<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.1</Version>
    <AssemblyName>DiscordicXP.Launcher</AssemblyName>
    <!-- Existing launchers validate this product identity before self-update. -->
    <Product>DiscodicXP.Launcher</Product>
    <Description>DiscordicXP Launcher</Description>
    <ApplicationIcon>Assets/Launcher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Launcher.ico"/>
  </ItemGroup>
</Project>
