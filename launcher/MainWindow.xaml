<Window x:Class="DiscodicXP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiscodicXP · Forever" Icon="Assets/Launcher.ico" Width="700" Height="880" MinWidth="540" MinHeight="600"
        Background="#18171A" Foreground="#E9E5DF" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="DiscodicXP" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
            <TextBlock Text="Обновления и прогресс WoW Forever" Margin="0,2,0,24" Foreground="#BDB6AD"/>
            <Border Background="#252126" Padding="12" CornerRadius="6" Margin="0,0,0,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LauncherVersionLabel" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="LauncherCheckButton" Content="Проверить обновление" Padding="10,6" Margin="8,0,0,0" Click="LauncherCheck_Click"/>
                    </Grid>
                    <TextBlock x:Name="LauncherUpdateLabel" Text="Обновления лаунчера проверяются при запуске." FontSize="12"
                               Foreground="#BDB6AD" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button x:Name="LauncherUpdateButton" Content="Обновить и перезапустить" Margin="0,10,0,0" Visibility="Collapsed" Click="LauncherUpdate_Click"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Сервер DiscodicXP" Margin="0,0,0,6"/>
            <TextBox x:Name="ServerBox" AutomationProperties.Name="Сервер обновлений"/>
            <TextBlock Text="Ключ этого компьютера" Margin="0,16,0,6"/>
            <PasswordBox x:Name="DeviceKeyBox" AutomationProperties.Name="Ключ компьютера"/>
            <TextBlock Text="Выдаётся отдельно. Подключать GitHub на этом компьютере не требуется."
                       FontSize="12" Foreground="#BDB6AD" TextWrapping="Wrap" Margin="0,6,0,18"/>
            <TextBlock Text="Папка Interface\AddOns" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AddOnsBox" AutomationProperties.Name="Папка AddOns"/>
                <Button Grid.Column="1" x:Name="BrowseButton" Content="Выбрать…" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <Border Background="#252126" Padding="16" Margin="0,24,0,16" CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="InstalledLabel" Text="Установленная версия: —"/>
                    <TextBlock x:Name="AvailableLabel" Text="Доступная версия: —" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CheckButton" Content="Проверить" Click="Check_Click"/>
                <Button Grid.Column="2" x:Name="UpdateButton" Content="Обновить аддон" Click="Update_Click"/>
            </Grid>
            <Border BorderBrush="#494035" BorderThickness="0,1,0,0" Margin="0,22,0,16" Padding="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="GuideLabel" Text="Гайды из админки" FontSize="18" Foreground="{StaticResource Gold}"/>
                    <TextBlock Text="Обновляй маршруты при открытой игре. После загрузки выполни /reload в WoW."
                               TextWrapping="Wrap" FontSize="12" Foreground="#BDB6AD" Margin="0,8,0,12"/>
                    <Button x:Name="GuideUpdateButton" Content="Обновить гайды" Click="GuideUpdate_Click"/>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,12" Visibility="Collapsed" Foreground="{StaticResource Gold}"/>
            <TextBlock x:Name="StatusLabel" Text="Укажи ключ компьютера и папку AddOns."
                       TextWrapping="Wrap" Foreground="#BDB6AD"/>
            <TextBlock Text="Перед установкой закрой WoW. Настройки и прогресс персонажей остаются в папке WTF."
                       TextWrapping="Wrap" FontSize="12" Foreground="#BDB6AD" Margin="0,16,0,0"/>
            <Border BorderBrush="#494035" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="Прогресс персонажа" FontSize="20" Foreground="{StaticResource Gold}"/>
                    <TextBlock Text="После обновления аддона войди персонажем и нормально выйди из WoW. Затем найди персонажа в списке."
                               TextWrapping="Wrap" FontSize="12" Foreground="#BDB6AD" Margin="0,8,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CharacterBox" DisplayMemberPath="Label" AutomationProperties.Name="Персонаж для синхронизации"
                                  MinHeight="34" Foreground="#18171A" Background="#E9E5DF"/>
                        <Button Grid.Column="1" x:Name="ScanButton" Content="Найти" Margin="8,0,0,0" Click="Scan_Click"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="SyncButton" Content="Синхронизировать" Click="Sync_Click"/>
                        <Button Grid.Column="2" x:Name="RestoreButton" Content="Загрузить с сервера" Click="Restore_Click"/>
                    </Grid>
                    <TextBlock Text="Синхронизация при закрытом WoW. Перед загрузкой создаётся резервная копия локального сохранения."
                               TextWrapping="Wrap" FontSize="12" Foreground="#BDB6AD" Margin="0,12,0,0"/>
                    <CheckBox x:Name="AutoSyncBox" IsChecked="True" Margin="0,14,0,0" Foreground="#BDB6AD">
                        <TextBlock Text="Сохранять выбранного персонажа после выхода из WoW, пока лаунчер открыт" TextWrapping="Wrap" FontSize="12"/>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
